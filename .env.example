# Server-side LLM used by /api/words. Never use a VITE_ prefix for keys.
# Any OpenAI-compatible endpoint works. Numbered keys are rotated in order.

# Primary: Groq (free tier, fast, JSON mode)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY1=your-groq-key-1
LLM_API_KEY2=your-groq-key-2

# Fallback: Cohere (OpenAI compatibility API)
# If response_format is rejected, the code automatically retries without it.
LLM_FALLBACK_BASE_URL=https://api.cohere.ai/compatibility/v1
LLM_FALLBACK_MODEL=command-a-03-2025
LLM_FALLBACK_API_KEY1=your-cohere-key-1
LLM_FALLBACK_API_KEY2=your-cohere-key-2

# Optional: add more providers as a JSON array. These are tried after the above.
# LLM_PROVIDERS=[{"name":"gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","apiKeys":["key1","key2"],"model":"gemini-2.5-flash-lite"}]

# Optional tuning
# LLM_TIMEOUT_MS=60000
# LLM_COOLDOWN_MS=60000
# LLM_AUTH_COOLDOWN_MS=600000

# Local Ollama (development only; not for Vercel)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
