{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/words.js": {
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "qwen/qwen3.8-27b",
    "LLM_FALLBACK_BASE_URL": "https://api.cohere.ai/compatibility/v1",
    "LLM_FALLBACK_MODEL": "command-a-03-2025"
  },
  "build": {
    "env": {
      "LLM_API_KEY1": "@llm_api_key1",
      "LLM_API_KEY2": "@llm_api_key2",
      "LLM_FALLBACK_API_KEY1": "@llm_fallback_api_key1",
      "LLM_FALLBACK_API_KEY2": "@llm_fallback_api_key2"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
