{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/words.js": {
      "runtime": "nodejs20.x"
    }
  },
  "env": {
    "LLM_BASE_URL": {
      "value": "https://api.groq.com/openai/v1"
    },
    "LLM_MODEL": {
      "value": "qwen/qwen3.8-27b"
    },
    "LLM_API_KEY1": {
      "placeholder": "your-groq-key-1"
    },
    "LLM_API_KEY2": {
      "placeholder": "your-groq-key-2"
    },
    "LLM_FALLBACK_BASE_URL": {
      "value": "https://api.cohere.ai/compatibility/v1"
    },
    "LLM_FALLBACK_MODEL": {
      "value": "command-a-03-2025"
    },
    "LLM_FALLBACK_API_KEY1": {
      "placeholder": "your-cohere-key-1"
    },
    "LLM_FALLBACK_API_KEY2": {
      "placeholder": "your-cohere-key-2"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
